{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=notification.db"
  },
  "JwtSettings": {
    "Secret": "SuperSecretKeyForJobHubIdentityApiThatIsAtLeast32BytesLong!",
    "Issuer": "JobHubIdentityAPI",
    "Audience": "JobHubClients"
  },
  "NotificationApi": {
    "ApiKey": "JobHubNotificationInternalKey-ChangeInProduction"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "RabbitMq": {
    "Enabled": false,
    "ConnectionUri": "amqp://guest:guest@localhost:5672",
    "AllowInsecureAmqp": false,
    "ApplicationsExchange": "jobhub.applications.v1",
    "RecruitmentExchange": "jobhub.recruitment.v1",
    "ApplicationsQueue": "notification.applications",
    "RecruitmentQueue": "notification.recruitment"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

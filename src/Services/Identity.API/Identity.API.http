@Identity.API_HostAddress = http://localhost:5283

### Register candidate
POST {{Identity.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Ana",
  "lastName": "Petrovic",
  "email": "ana@example.com",
  "password": "Pass123!",
  "role": "Candidate"
}

### Confirm email (paste userId + token from register)
POST {{Identity.API_HostAddress}}/api/auth/confirm-email
Content-Type: application/json

{
  "userId": "{{userId}}",
  "token": "{{emailToken}}"
}

### Login
POST {{Identity.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "Pass123!"
}

### Forgot password
POST {{Identity.API_HostAddress}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "ana@example.com"
}

### Reset password (paste token from forgot-password)
POST {{Identity.API_HostAddress}}/api/auth/reset-password
Content-Type: application/json

{
  "email": "ana@example.com",
  "token": "{{resetToken}}",
  "newPassword": "NewPass123!"
}

### Current user (paste token from login)
GET {{Identity.API_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}
